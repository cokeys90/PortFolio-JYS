# Firebase 클라이언트 SDK 설정
# Firebase 콘솔 > 프로젝트 설정 > 일반 > 내 앱 > Firebase SDK snippet > 구성 에서 복사
# 실제 값은 .env.local 에 채워넣을 것 (.env.local은 git ignore됨)

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=portfolio-jys.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=portfolio-jys
VITE_FIREBASE_STORAGE_BUCKET=portfolio-jys.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Firebase App Check (reCAPTCHA v3) — 봇/자동화 트래픽 차단
# Firebase 콘솔 > App Check > 앱 등록 > reCAPTCHA v3 site key
VITE_RECAPTCHA_V3_SITE_KEY=your_recaptcha_v3_site_key

# Web3Forms — 문의 폼 이메일 발송
# https://web3forms.com 에서 무료 access key 발급 (cokeys90@gmail.com 으로 등록)
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key
